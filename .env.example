# Salin ke .env (lokal) atau isi di Vercel → Project → Settings → Environment Variables.

# Postgres. Dari Neon: Dashboard → Connect → connection string (pakai yang "pooled").
# Kosongkan untuk lokal: galeri disimpan sebagai file JSON di server/data.
DATABASE_URL=

# Vercel Blob (otomatis terisi saat Blob store dihubungkan ke project).
# Kosongkan untuk lokal: unggahan disimpan di server/data/uploads.
BLOB_READ_WRITE_TOKEN=

# Opsional
# PORT=3001
# DATA_DIR=./server/data
